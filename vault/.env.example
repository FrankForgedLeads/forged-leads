# Beeyond Vault — environment variables
# Copy this file to .env (local dev) and set the matching values in Netlify's
# Site settings > Environment variables for production/preview deploys.
#
# Vars prefixed VITE_ are exposed to the browser bundle — never put a secret
# key behind a VITE_ prefix. Non-VITE_ vars are server-only (Netlify Functions).

# --- Supabase ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only, used in Netlify Functions (webhook, admin ops). Never expose to the client.
SUPABASE_SERVICE_KEY=

# --- Stripe ---
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_CREW_MONTHLY=
STRIPE_PRICE_CREW_YEARLY=

# --- Resend (transactional + monthly update email) ---
RESEND_API_KEY=

# --- App config ---
# Email address granted admin access (items CRUD, leads, subscriber list)
ADMIN_EMAIL=
# Where Scope Checker leads get emailed
LEADS_EMAIL=leads@beeyondestimators.com
