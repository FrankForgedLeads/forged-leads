# Beeyond Vault — environment variables
# Copy this file to .env (local dev) and set the matching values in Netlify's
# Site settings > Environment variables for production/preview deploys.
#
# Vars prefixed VITE_ are exposed to the browser bundle — never put a secret
# key behind a VITE_ prefix. Non-VITE_ vars are server-only (Netlify Functions).

# --- Supabase ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only copy of the same project URL, for Netlify Functions. Netlify
# does expose VITE_-prefixed vars to server code too (the prefix only
# controls what Vite inlines into the browser bundle), but functions use
# this explicit non-prefixed name instead of relying on that.
SUPABASE_URL=
# Server-only, used in Netlify Functions (webhook, checkout, admin ops). Never expose to the client.
SUPABASE_SERVICE_KEY=

# --- Stripe ---
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_CREW_MONTHLY=
STRIPE_PRICE_CREW_YEARLY=

# --- Resend (transactional + monthly update email) ---
RESEND_API_KEY=

# --- Estimate Review analysis engine (server-only, analyze-review function) ---
# Get one at console.anthropic.com. This is the one real per-review cost in
# an otherwise free-tier stack — see README's Phase 3 notes.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-4-5 (the cheapest current Claude model
# that still supports this analysis) if unset — only set this to override,
# e.g. to claude-sonnet-5 if Haiku's findings prove too shallow in practice.
ESTIMATE_ANALYSIS_MODEL=
# Optional. Max analysis runs per user per rolling 24h, cost-control ceiling
# so a compromised account or bug can't run up an unbounded AI bill. Default 20.
ANALYSIS_DAILY_LIMIT=

# --- App config ---
# Email address granted admin access (items CRUD, leads, subscriber list)
ADMIN_EMAIL=
# Where Scope Checker leads get emailed
LEADS_EMAIL=leads@beeyondestimators.com
